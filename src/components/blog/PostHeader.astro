---
import { Image } from "astro:assets";
import Profile from "@/assets/avatar3.webp";
import Badge from "@/components/ui/Badge.astro";
import { formatDate } from "@/utils/formatDate";

interface Props {
  title: string;
  date: Date;
  categories: string[];
  readingTime?: number;
  cover?: string;
}

const { title, date, categories, readingTime, cover } = Astro.props;
---

<div class="relative overflow-hidden pb-10 pt-32 sm:pt-36">
  <div class="mesh-bg" aria-hidden="true"></div>
  <div class="grain-overlay" aria-hidden="true"></div>

  <div class="container-custom relative z-10 max-w-4xl">
    <!-- Breadcrumb -->
    <nav class="mb-6 text-sm text-text-secondary" aria-label="breadcrumb">
      <a href="/blog" class="hover:text-accent-primary transition-colors">Blog</a>
      <span class="mx-2 opacity-40">/</span>
      <span class="text-text-primary">{categories[0]}</span>
    </nav>

    <!-- Categories -->
    <div class="mb-5 flex flex-wrap gap-2">
      {categories.map((cat) => <Badge text={cat} variant="accent" />)}
    </div>

    <!-- Title -->
    <h1
      class="mb-6 font-heading text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl gradient-text"
    >
      {title}
    </h1>

    <!-- Author + Meta row -->
    <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
      <div class="flex items-center gap-3">
        <Image
          src={Profile}
          alt="Lucas Alonso"
          width={40}
          height={40}
          class="h-10 w-10 rounded-full border border-border/70 object-cover"
        />
        <div>
          <p class="text-sm font-semibold leading-tight">Lucas Alonso</p>
          <p class="text-xs text-text-secondary">Full Stack Developer</p>
        </div>
      </div>

      <div
        class="flex items-center gap-4 text-sm text-text-secondary"
        aria-label="Metadata del artículo"
      >
        <span
          class="h-px w-4 bg-gradient-to-r from-transparent to-border/60"
          aria-hidden="true"
        ></span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {
          readingTime && (
            <>
              <span class="opacity-40">·</span>
              <span>{readingTime} min lectura</span>
            </>
          )
        }
      </div>
    </div>
  </div>
</div>

{
  cover && (
    <div class="container-custom max-w-4xl pb-8">
      <div class="glass-card overflow-hidden !rounded-2xl p-0">
        <Image
          src={cover}
          alt={title}
          width={1400}
          height={788}
          class="h-[260px] w-full object-cover sm:h-[440px]"
        />
      </div>
    </div>
  )
}
