---
interface Props {
  text: string;
  href?: string;
  variant?: "primary" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
  target?: string;
  class?: string;
  [key: string]: any;
}

const {
  text,
  href,
  variant = "primary",
  size = "md",
  target,
  class: className = "",
  ...rest
} = Astro.props;

const baseClasses =
  "group relative inline-flex items-center justify-center gap-2 overflow-hidden rounded-xl font-semibold tracking-tight transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-primary/50 focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary";

const variants: Record<string, string> = {
  primary:
    "text-white shadow-[0_14px_30px_-12px_var(--glow-primary)] [background-image:linear-gradient(110deg,var(--accent-primary),var(--accent-secondary))] hover:shadow-[0_18px_40px_-12px_var(--glow-primary)] hover:-translate-y-0.5",
  outline:
    "surface-bg border border-border text-text-primary backdrop-blur hover:-translate-y-0.5 hover:border-accent-primary/50 hover:[background-color:rgb(99_102_241_/_0.08)]",
  ghost: "text-text-secondary hover:bg-bg-tertiary hover:text-text-primary",
};

const sizes: Record<string, string> = {
  sm: "px-4 py-2 text-sm",
  md: "px-5 py-2.5 text-sm",
  lg: "px-6 py-3 text-sm sm:text-base",
};

const classes = `${baseClasses} ${variants[variant]} ${sizes[size]} ${className}`;
---

{
  href ? (
    <a
      href={href}
      class={classes}
      target={target}
      rel={target === "_blank" ? "noopener noreferrer" : undefined}
      {...rest}
    >
      {text}
      <slot />
    </a>
  ) : (
    <button class={classes} {...rest}>
      {text}
      <slot />
    </button>
  )
}
