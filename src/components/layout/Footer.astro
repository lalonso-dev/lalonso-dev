---
import KofiButton from "@/components/KofiButton.astro";
const currentYear = new Date().getFullYear();

const navLinks = [
  { label: "Inicio", href: "/" },
  { label: "Sobre mí", href: "/sobre-mi" },
  { label: "Proyectos", href: "/proyectos" },
  { label: "Servicios", href: "/servicios" },
  { label: "Blog", href: "/blog" },
  { label: "Contacto", href: "/contacto" },
];

const socials = [
  {
    label: "GitHub",
    href: "https://github.com/lalonso-dev",
    icon: '<path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.35.96.1-.74.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.18-1.49 3.14-1.18 3.14-1.18.63 1.59.24 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.78 1.05.78 2.12v3.14c0 .3.2.66.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/>',
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/lucasalbertoalonso/",
    icon: '<path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/>',
  },
];
---

<footer class="relative overflow-hidden border-t border-border/60 section-alt">
  <div class="container-custom relative z-10 py-14">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <!-- Brand -->
      <div>
        <a href="/" class="font-heading text-2xl font-bold tracking-tight text-text-primary">
          lalonso<span class="gradient-text">.dev</span>
        </a>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-text-secondary">
          Desarrollo enfocado en producto, performance y arquitectura
          escalable. Desde México para todo el mundo.
        </p>
        <div class="mt-5 flex items-center gap-2">
          {
            socials.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="surface-bg inline-flex h-9 w-9 items-center justify-center rounded-xl border border-border text-text-secondary transition hover:-translate-y-0.5 hover:border-accent-primary/40 hover:text-accent-primary"
              >
                <svg
                  class="h-4 w-4"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  set:html={social.icon}
                />
              </a>
            ))
          }
          <KofiButton compact />
        </div>
      </div>

      <!-- Nav -->
      <nav aria-label="Footer">
        <p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.2em] text-text-secondary">
          Navegación
        </p>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-2.5 text-sm">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-text-secondary transition hover:text-text-primary"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Contact -->
      <div>
        <p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.2em] text-text-secondary">
          ¿Hablamos?
        </p>
        <a
          href="/contacto"
          class="group inline-flex items-center gap-2 text-sm font-semibold text-accent-primary"
        >
          Cuéntame tu proyecto
          <svg
            class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
          >
        </a>
        <p class="mt-3 text-sm text-text-secondary">
          Respuesta en menos de 24 horas.
        </p>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-border/60 pt-6 text-xs text-text-secondary sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {currentYear} lalonso.dev — Lucas Alonso</p>
      <p>
        Hecho con <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-text-primary transition hover:text-accent-primary">Astro</a
        > · Diseñado y construido a mano
      </p>
    </div>
  </div>
</footer>
