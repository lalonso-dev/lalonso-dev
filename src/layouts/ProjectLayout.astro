---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import Badge from "@/components/ui/Badge.astro";
import ProjectGallery from "@/components/projects/ProjectGallery.astro";
import CTA from "@/components/home/CTA.astro";
import Button from "@/components/ui/Button.astro";

const { frontmatter } = Astro.props;
const currentSlug = Astro.url.pathname.split("/").filter(Boolean).pop();

const allProjects = (await getCollection("projects")).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);
const currentIndex = allProjects.findIndex((p) => p.slug === currentSlug);
const prevProject = currentIndex > 0 ? allProjects[currentIndex - 1] : null;
const nextProject =
  currentIndex < allProjects.length - 1 ? allProjects[currentIndex + 1] : null;

const statusLabels: Record<string, string> = {
  live: "Live",
  development: "En desarrollo",
  completed: "Completado",
};

const statusVariants: Record<string, "success" | "accent"> = {
  live: "success",
  development: "accent",
  completed: "accent",
};

const projectUrl = Astro.url.href;
const projectCategory = (frontmatter.category ?? "").toLowerCase();
const isSoftwareProject = /(app|aplicaci[oó]n|saas|software|sistema)/i.test(
  projectCategory,
);

const projectJsonLd = isSoftwareProject
  ? {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: frontmatter.title,
      description: frontmatter.description,
      image: [
        new URL(
          frontmatter.cover ?? "/images/og-image.svg",
          Astro.site ?? Astro.url.origin,
        ).toString(),
      ],
      applicationCategory: frontmatter.category,
      operatingSystem: "Web",
      datePublished: new Date(frontmatter.date).toISOString(),
      dateModified: new Date(frontmatter.updatedAt ?? frontmatter.date).toISOString(),
      author: { "@type": "Person", name: "Lucas Alonso" },
      url: projectUrl,
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: frontmatter.title,
      description: frontmatter.description,
      image: [
        new URL(
          frontmatter.cover ?? "/images/og-image.svg",
          Astro.site ?? Astro.url.origin,
        ).toString(),
      ],
      datePublished: new Date(frontmatter.date).toISOString(),
      dateModified: new Date(frontmatter.updatedAt ?? frontmatter.date).toISOString(),
      author: { "@type": "Person", name: "Lucas Alonso" },
      url: projectUrl,
    };
---

<BaseLayout
  title={`${frontmatter.title} | Proyectos`}
  description={frontmatter.description}
  ogImage={frontmatter.cover ?? "/images/og-image.svg"}
  jsonLd={projectJsonLd}
>
  <Header />
  <main>
    <!-- Editorial header -->
    <section class="relative overflow-hidden pb-8 pt-32 sm:pt-36">
      <div class="mesh-bg" aria-hidden="true"></div>
      <div class="grain-overlay" aria-hidden="true"></div>

      <div class="container-custom relative z-10">
        <!-- Breadcrumb -->
        <nav class="mb-6 text-sm text-text-secondary" aria-label="breadcrumb">
          <a href="/proyectos" class="hover:text-accent-primary transition-colors"
            >Proyectos</a
          >
          <span class="mx-2 opacity-40">/</span>
          <span class="text-text-primary">{frontmatter.category}</span>
        </nav>

        <!-- Badges -->
        <div class="mb-5 flex flex-wrap items-center gap-2">
          <Badge text="PROJECT SHOWCASE" variant="accent" />
          <Badge
            text={statusLabels[frontmatter.status] || frontmatter.status}
            variant={statusVariants[frontmatter.status] ?? "accent"}
          />
        </div>

        <!-- Title -->
        <h1
          class="mb-5 max-w-4xl font-heading text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl"
        >
          <span class="gradient-text">{frontmatter.title}</span>
        </h1>

        <!-- Description -->
        <p class="max-w-2xl text-base text-text-secondary sm:text-lg">
          {frontmatter.description}
        </p>
      </div>
    </section>

    <!-- Cover image -->
    {
      frontmatter.cover && (
        <div class="container-custom pb-10">
          <div class="glass-card overflow-hidden !rounded-2xl p-0">
            <Image
              src={frontmatter.cover}
              alt={frontmatter.title}
              width={1600}
              height={900}
              class="h-[260px] w-full object-cover sm:h-[560px]"
            />
          </div>
        </div>
      )
    }

    <!-- Content + Sidebar -->
    <section class="section-padding pt-4 pb-12">
      <div class="container-custom">
        <div class="grid gap-10 lg:grid-cols-[1fr_300px]">
          <!-- Prose body -->
          <div
            class="body__project prose prose-lg max-w-none
              prose-headings:font-heading prose-headings:text-text-primary prose-headings:tracking-tight
              prose-p:text-text-secondary prose-p:leading-relaxed
              prose-a:text-accent-primary prose-a:no-underline hover:prose-a:underline
              prose-strong:text-text-primary
              prose-code:rounded prose-code:bg-bg-tertiary prose-code:px-1.5 prose-code:py-0.5 prose-code:text-accent-secondary prose-code:font-medium
              prose-pre:border prose-pre:border-border prose-pre:bg-bg-secondary prose-pre:rounded-xl
              prose-img:rounded-2xl prose-img:border prose-img:border-border/60
              prose-blockquote:border-l-accent-primary prose-blockquote:text-text-secondary
              prose-hr:border-border/60
              dark:prose-invert
              [&_pre_code]:bg-transparent [&_pre_code]:p-0 [&_pre_code]:rounded-none [&_pre_code]:text-inherit"
          >
            <slot />
          </div>

          <!-- Sidebar -->
          <aside>
            <div class="sticky top-24 space-y-5">
              <!-- Tech stack -->
              <div class="glass-card p-5">
                <p
                  class="mb-3 text-[11px] font-semibold uppercase tracking-[0.18em] text-text-secondary"
                >
                  Stack tecnológico
                </p>
                <div class="flex flex-wrap gap-2">
                  {
                    frontmatter.technologies.map((tech: string) => (
                      <Badge text={tech} variant="accent" />
                    ))
                  }
                </div>
              </div>

              <!-- Details -->
              <div class="glass-card divide-y divide-border/50 p-0 overflow-hidden">
                <div class="px-5 py-4">
                  <p
                    class="mb-3 text-[11px] font-semibold uppercase tracking-[0.18em] text-text-secondary"
                  >
                    Detalles
                  </p>
                  <dl class="space-y-3 text-sm">
                    <div class="flex items-start justify-between gap-2">
                      <dt class="text-text-secondary">Categoría</dt>
                      <dd class="font-semibold text-text-primary text-right">
                        {frontmatter.category}
                      </dd>
                    </div>
                    {
                      frontmatter.client && (
                        <div class="flex items-start justify-between gap-2">
                          <dt class="text-text-secondary">Cliente</dt>
                          <dd class="font-semibold text-text-primary text-right">
                            {frontmatter.client}
                          </dd>
                        </div>
                      )
                    }
                    <div class="flex items-start justify-between gap-2">
                      <dt class="text-text-secondary">Estado</dt>
                      <dd class="font-semibold text-text-primary text-right">
                        {statusLabels[frontmatter.status] || frontmatter.status}
                      </dd>
                    </div>
                  </dl>
                </div>

                {
                  (frontmatter.liveUrl || frontmatter.githubUrl) && (
                    <div class="flex flex-col gap-2 px-5 py-4">
                      {frontmatter.liveUrl && (
                        <Button
                          text="Ver proyecto live"
                          class="w-full"
                          href={frontmatter.liveUrl}
                          size="md"
                          target="_blank"
                          rel="noopener noreferrer"
                        />
                      )}
                      {frontmatter.githubUrl && (
                        <Button
                          text="GitHub Repo"
                          class="w-full"
                          rel="noopener noreferrer"
                          href={frontmatter.githubUrl}
                          variant="outline"
                          target="_blank"
                          size="md"
                        />
                      )}
                    </div>
                  )
                }
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- Testimonial -->
    {
      frontmatter.testimonial && (
        <section class="section-padding section-alt py-16">
          <div class="container-custom max-w-3xl text-center">
            <p class="mb-3 flex items-center justify-center gap-3 text-[11px] font-semibold uppercase tracking-[0.2em] text-accent-primary">
              <span class="h-px w-6 bg-gradient-to-r from-transparent to-accent-primary/60" aria-hidden="true" />
              Testimonial
              <span class="h-px w-6 bg-gradient-to-l from-transparent to-accent-primary/60" aria-hidden="true" />
            </p>
            <div class="glass-card p-8 text-center">
              <svg
                class="mx-auto mb-5 h-8 w-8 text-accent-primary/40"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
              </svg>
              <p class="mb-6 text-lg italic leading-relaxed text-text-secondary">
                "{frontmatter.testimonial.text}"
              </p>
              <div class="border-t border-border/60 pt-4">
                <p class="font-semibold text-text-primary">
                  {frontmatter.testimonial.author}
                </p>
                <p class="text-sm text-text-secondary">
                  {frontmatter.testimonial.role}
                </p>
              </div>
            </div>
          </div>
        </section>
      )
    }

    <!-- Gallery -->
    {
      frontmatter.gallery && frontmatter.gallery.length > 0 && (
        <ProjectGallery images={frontmatter.gallery} title={frontmatter.title} />
      )
    }

    <CTA />

    <!-- Prev / Next navigation -->
    {
      (prevProject || nextProject) && (
        <section class="section-padding pt-0 pb-12">
          <div class="container-custom">
            <div class="glass-card grid grid-cols-2 overflow-hidden divide-x divide-border/60">
              <div class="p-5 sm:p-6">
                {prevProject ? (
                  <a
                    href={`/proyectos/${prevProject.slug}`}
                    class="group flex flex-col gap-1 transition-colors hover:text-accent-primary"
                  >
                    <span class="text-xs font-semibold uppercase tracking-[0.15em] text-text-secondary group-hover:text-accent-primary/70">
                      ← Anterior
                    </span>
                    <span class="font-heading font-bold leading-snug text-text-primary line-clamp-2 group-hover:text-accent-primary">
                      {prevProject.data.title}
                    </span>
                  </a>
                ) : (
                  <span class="text-sm text-text-secondary/40">—</span>
                )}
              </div>
              <div class="p-5 sm:p-6 text-right">
                {nextProject ? (
                  <a
                    href={`/proyectos/${nextProject.slug}`}
                    class="group flex flex-col gap-1 transition-colors hover:text-accent-primary"
                  >
                    <span class="text-xs font-semibold uppercase tracking-[0.15em] text-text-secondary group-hover:text-accent-primary/70">
                      Siguiente →
                    </span>
                    <span class="font-heading font-bold leading-snug text-text-primary line-clamp-2 group-hover:text-accent-primary">
                      {nextProject.data.title}
                    </span>
                  </a>
                ) : (
                  <span class="text-sm text-text-secondary/40">—</span>
                )}
              </div>
            </div>
          </div>
        </section>
      )
    }
  </main>
  <Footer />
</BaseLayout>
